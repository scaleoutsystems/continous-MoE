{
  // Example config to instantiate the Image-level Top-1 MoE ViT
  "model": {
    "name": "vit_moe_imagelevel",
    "num_classes": 10,
    "embed_dim": 256,
    "depth": 10,
    "num_heads": 4,
    "mlp_ratio": 1.0,
    "patch_size": 16,
    // Optionally initialize from a pretrained ViT. Use "small" to fetch
    // the timm 'vit_small_patch16_224' pretrained model. For a tiny model
    // provide a local checkpoint path in `pretrained_vit_tiny_path`.
    "pretrained_vit": null, // transfers weights from model (vit-small)
    "pretrained_vit_tiny_path": null, // transfers weights from saved model (vit-tiny)
    "moe_layer_indices": [6,7,8,9],

    // MoE-specific options
    "num_experts": 4,
    "alpha_fast": 0.8,
    "alpha_slow": 0.99,
    "repulsion_k": 2,
    "repulsion_margin": 0.2,
    "moe_lambda_fast": 0.05,
    "moe_lambda_slow": 0.05,
    "moe_lambda_align": 0.5,
    "moe_lambda_cons": 0.1,
    "moe_lambda_lb_init": 1.0,
    "moe_anneal_epochs": 100,
    "detach_align_steps": 100,
    // Routing temperature annealing: initial temperature for soft routing. Set to 0 or omit for hard argmax.
    "routing_temp": 1.0,
    // Number of epochs to linearly anneal routing_temp -> 0 (hardmax). Set 0 to disable.
    "routing_anneal_epochs": 100,
    // Expert-group learning rate can be specified as an absolute LR or a multiplier of base LR
    "moe_expert_lr_multiplier": 10.0 // base multiplier option
    // "moe_expert_lr": 0.001 // absolute LR option
  },
  "loss": {
    "name": "cross_entropy",
    "lr": 1e-3
  },
  "optimizer": {
    "name": "adam"
  },
  "epochs_per_domain": 1
}
