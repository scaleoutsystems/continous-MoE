{
  // --------------------------------------------------------------------
  // Seeds (optional): global defaults and per-stage overrides
  "seeds": {
    // any seed value of 0 (or the string "random") means "do not set a
    // seed"; this allows parts of the pipeline to remain nondeterministic.
    "global": 0,
    "dataset": 1,
    "partition": 2,
    "model": 3,
    "pretrain": 4,
    "training": 5
    //"replay": 123
  },

  // --------------------------------------------------------------------
  // Dataset specification
  "dataset": "cifar10",
  "dataset_root": "./datasets",
  // For CORe50 use:
  // "dataset": "core50",
  // "dataset_root": "./datasets",
  // "settings": [1,2,3,4], // list of session folders to include (s1,s2,...)
  // Note: when using partition.type == "domainIncremental" the number of
  // settings must be divisible by "num_partitions" so settings can be
  // evenly split across domains.
  //
  // For OfficeHome use (OfficeHomeDataset_10072016):
  // "dataset": "officehome",
  // "dataset_root": "./datasets",
  // "settings": ["Art","Clipart","Product","Real World"], // domains to include
  // Note: when using partition.type == "domainIncremental" the number of
  // settings must be divisible by "num_partitions" so domains can be
  // evenly split across partitions.
  //
  // For ImageNet (ILSVRC2012) use:
  // "dataset": "imagenet",
  // and place the ILSVRC2012 train/val folders under dataset_root/imagenet
  "mini_dataset": 12000,                // integer sample count or null for full
  "resize": 0, // 0 = no resize. This resize affects all images

  "augmentation": {
    "random_resize_crop": false,
    "random_crop": true,
    "resize": 32, // affects both random_resize_crop and random_crop
    "random_flip": true,
    "color_jitter": true,
    "blur": true,
    "noise": true
  },

  // --------------------------------------------------------------------
  // Partitioning (pick one of these blocks)
  "num_partitions": 5,
  "partition": {
    // Dirichlet-split example:
    // "type": "dirichlet",
    // "alpha": 0.3,
    // "min_size": 10,
    // "balanced": false

    // Static / contiguous split example:
    // "type": "static"

    "type": "dirichlet",
    "alpha": 0.3,
    "min_size": 700,
    "balanced": true
  },

  "train_frac": 0.8,
  "batch_size": 128,
  "shuffle": true,

  // --------------------------------------------------------------------
  // Model configuration
  "model": {
    "name": "vit_moe", // "convnext_tiny", "resnet18", "vit_moe"
    "num_classes": 10,
    "pretrained": false,
    "embed_dim": 384, 
    "depth": 8, 
    "num_heads": 6, 
    "mlp_ratio": 4.0,
    // "img_size" is added automatically by the loader based on the first
    // training batch.  You may override it here if you know the input
    // resolution in advance; otherwise leave it unspecified.
    // "img_size": 224,
    "patch_size": 8,
    // If using vit_moe, you may specify additional keys for the MoE.
    // Configuration separates the number of unshared and shared experts
    // explicitly
    "moe_layer_indices": "every_other", // "every_other", "back_half_every_other", "all"
    "moe_num_unshared_experts": 4,
    "moe_num_shared_experts": 1,
    "moe_top_k": 1, // only selects between unshared, shared are always used
    "moe_route_with_cls_token": true
    ,
    // Optional: initialize from a pretrained ViT. Set to "small" to use
    // timm's 'vit_small_patch16_224' pretrained weights and transfer them
    // into the MoE model (FFN weights copied into each expert). Use
    // `pretrained_vit_tiny_path` to load a local tiny checkpoint.
    "pretrained_vit": null,
    "pretrained_vit_tiny_path": null
    // Optional: per-expert learning-rate multipliers for MoE experts.
    // - "moe_unshared_lr_multipliers": scalar or list (length == num_unshared_experts)
    //    Example: [1.0, 0.5, 0.2] will set the three unshared experts to lr*1.0, lr*0.5, lr*0.2
    // - "moe_shared_lr_multiplier": scalar multiplier applied to all shared experts
    // - "moe_shared_lr_multipliers": list per-shared-expert (alternative to scalar)
    // If omitted or set to null, experts use the base learning rate.
    // "moe_unshared_lr_multipliers": null,
    // "moe_shared_lr_multiplier": null,
    // "moe_shared_lr_multipliers": null
  },
  // Example: use the pretrained ViT + prototype MoE head described in the
  // project notes. Uncomment and adapt to enable.
  // "model": {
  //   "name": "pretrained_vit_moe_head",
  //   "num_classes": 10,
  //   "pretrained": true,
  //   "num_experts": 4,
  //   "prototype_ema": 0.99,
  //   "router_temperature": 0.1,
  //   "freeze_encoder": true,
  //   "use_attraction": true,
  //   "use_repulsion": true,
  //   "use_consistency": true,
  //   "use_global_classification": false,
  //   "loss_weights": {"attraction": 1.0, "repulsion": 1.0, "consistency": 1.0, "classification": 1.0}
  // },

  // --------------------------------------------------------------------
  // Loss and learning rate
  "loss": {
    "name": "focal", // options: "cross_entropy", "weighted_cross_entropy", "focal"
    "lr": 0.001,
    // set to true to enable per-class weighting based on partition distribution
    "weighted": true,
    // upper limit applied when computing inverse-frequency weights
    "weight_upper_limit": 20.0,
    // if true new weights will be averaged with the previous set
    "weight_cumulative": false,

    // focal-loss specific parameters (ignored for plain CE)
    // "alpha" may be a scalar, an array of length num_classes, or the
    // string "auto"/null.  In the latter case the alpha values are computed
    // from the current partition's class counts, identical to the behaviour
    // of the weighted cross-entropy loss.

    "alpha": "auto",
    "gamma": 2.0
  },

  // --------------------------------------------------------------------
  // Optimizer
  "optimizer": {
    "name": "adamw"          // "adam", "adamw", or "sgd"
    // "momentum": 0.9        // only for SGD
  },

  // --------------------------------------------------------------------
  // Scheduler (optional)
  // "scheduler": {
  //   "name": null 
    // "cosine" for CosineAnnealingLR
    // Used for CosineAnnealing; if null, uses epochs_per_domain as T_max
    //"T_max": null
  // },

  "pretrain": {
    "enabled": true,
    "num_samples": 2000,
    "with_replacement": false,
    "epochs": 5 // specific to just pretraining. If 0 or null or missing, uses epochs_per_domain
  },

  "pretrain_scheduler": {
    "name": "linear", // e.g. "cosine", "step", "linear"
    "start_factor": 0.1,
    "end_factor": 1.0
  },

  "epochs_per_domain": 1,

  // --------------------------------------------------------------------
  // Continual learning options
  "router_balancing": true,
  // maximum balance strength (starting value). Backwards-compatible with
  // "router_balance_strength" which is treated as the max if present.
  "router_balance_strength": 0.5,
  // minimum balance strength at the end of anneal period
  "router_balance_min": 0.0,
  // number of epochs over which to cosine-anneal balance strength from max -> min
  "router_balance_anneal_epochs": 100,
  "router_freeze_after_epochs": 1,
  // set to a value <1 to slow router learning; 0 is equivalent to freezing
  "router_lr_multiplier": 0.0,
  // optionally change the multiplier at a particular epoch (useful for
  // scheduling); null means never change midrun
  "router_lr_multiplier_after_epochs": null,

  // Optional warmup schedule applied only to the first domain's dataloader.
  // LR is cosine-annealed from `warmup_starting_LR` -> the optimizer group
  // initial LR over `warmup_epochs` epochs. Provide absolute LR for
  // `warmup_starting_LR`.
  "warmup_epochs": 0,
  "warmup_starting_LR": null,

  // --------------------------------------------------------------------
  // Baseline reference (enable to compute FWT/intransience)
  "baseline": {
    "enabled": true,
    "train": true,
    "accuracies": null
  }
}