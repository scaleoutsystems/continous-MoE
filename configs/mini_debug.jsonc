{
  // Very small test config for quick runs (mini CIFAR)
  "seeds": {
    "global": 0
  },
  "dataset": "cifar10",
  "dataset_root": "./datasets",
  "mini_dataset": 200,
  "resize": 32,
  "num_partitions": 2,
  "partition": {
    "type": "dirichlet",
    "alpha": 0.5,
    "min_size": 10,
    "balanced": true
  },
  "train_frac": 0.8,
  "batch_size": 32,
  "shuffle": true,
  "model": {
    "name": "vit_moe",
    "num_classes": 10,
    "pretrained": false,
    "patch_size": 8,
    "moe_layer_indices": "every_other",
    "moe_num_unshared_experts": 2,
    "moe_num_shared_experts": 0,
    "moe_top_k": 1,
    "moe_route_with_cls_token": true
  },
  "loss": {
    "name": "cross_entropy",
    "lr": 0.001
  },
  "optimizer": { "name": "adam" },
  "epochs_per_domain": 1,
  "pretrain": { "enabled": false },
  "num_workers": 0
}
